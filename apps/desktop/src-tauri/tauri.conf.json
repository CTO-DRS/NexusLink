{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusLink",
  "version": "1.0.0",
  "identifier": "sa.drs.nexuslink",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "NexusLink",
        "width": 480,
        "height": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "NexusLink — device bridge",
    "longDescription": "NexusLink: جسر الأجهزة — الهاتف وسطح المكتب في منصة واحدة. يضم سيرفر Nexus كاملاً داخل التطبيق (واجهة + جسور + بوابة + mDNS).",
    "targets": [
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server",
      "resources/comms",
      "resources/gateway"
    ]
  }
}