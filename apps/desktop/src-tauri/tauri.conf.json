{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusLink",
  "version": "1.2.0",
  "identifier": "sa.drs.nexuslink",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "nexus"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/CTO-DRS/NexusLink/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENUNGRjAyNUEzQ0FDNkMKUldSc3JEeGFBdjljSGVDWjIrck1uMmpNSWd3enJ5MGwzNUsvdHY0aUVzV0pjczREZnNPeDdYd2EK",
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "NexusLink - LAN device bridge",
    "longDescription": "NexusLink: device bridge for your LAN - the desktop app is the hub (embedded full Nexus server: UI + bridges + gateway + mDNS), the phone app is the agent. MSI constraint: this text must stay ASCII (code page 1252) - see the packaging contract.",
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "nsis",
      "msi",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server",
      "resources/comms",
      "resources/gateway",
      "vdd",
      "vcam"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
