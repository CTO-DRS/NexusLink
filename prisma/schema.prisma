// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — طبقة الاتصالات الشخصية =====

model NexusNotification {
  id         String   @id @default(cuid())
  appId      String
  appName    String
  title      String
  body       String
  deviceId   String   @default("galaxy-s24")
  actionable Boolean  @default(true)
  // new | read | replied | muted | hidden | archived
  status     String   @default("new")
  replyText  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model NexusFilter {
  id           String    @id @default("main")
  hiddenApps   String    @default("[]") // JSON: appId[]
  grouping     Boolean   @default(true)
  quietUntil   DateTime?
  soundEnabled Boolean   @default(true)
}

model NexusConversation {
  id          String         @id @default(cuid())
  address     String         @unique
  contactName String?
  unread      Int            @default(0)
  updatedAt   DateTime       @updatedAt
  messages    NexusMessage[]
}

model NexusMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  direction      String // in | out
  status         String            @default("delivered") // sending | sent | delivered | read
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model NexusContact {
  id       String  @id @default(cuid())
  name     String
  phone    String  @unique
  email    String?
  favorite Boolean @default(false)
}

model NexusCallLog {
  id          String   @id @default(cuid())
  number      String
  contactName String?
  direction   String // in | out | missed
  startedAt   DateTime
  durationSec Int      @default(0)

  @@index([startedAt])
}

model NexusPhone {
  id        String   @id @default("main")
  dnd       Boolean  @default(false)
  dndSource String? // pc | phone
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — المرحلة 9: طبقة الإنتاجية =====

model ProdClip {
  id         String   @id @default(cuid())
  deviceId   String
  deviceName String
  kind       String   @default("text") // text | image | file
  content    String   @default("") // نص أو dataUrl مصغّر للصور
  fileName   String? // للملفات: الاسم الحقيقي على الجهاز المصدر
  filePath   String? // مسار افتراضي للملف على الجهاز المصدر
  size       Int      @default(0)
  mode       String   @default("manual") // auto | manual
  received   Boolean  @default(false) // استُلم فعلياً على جهاز آخر (نسخ بايتات)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SyncPair {
  id         String    @id @default(cuid())
  deviceA    String
  folderA    String
  deviceB    String
  folderB    String
  active     Boolean   @default(true)
  autoSync   Boolean   @default(true)
  lastSyncAt DateTime?
  lastCount  Int       @default(0)
  lastBytes  Int       @default(0)
  running    Boolean   @default(false)
  progress   Int       @default(0) // 0..100
  createdAt  DateTime  @default(now())

  events SyncEvent[]
}

model SyncEvent {
  id      String   @id @default(cuid())
  pairId  String
  pair    SyncPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  relPath String
  action  String // new-A2B | new-B2A | upd-A2B | upd-B2A | conflict | skip
  bytes   Int      @default(0)
  at      DateTime @default(now())

  @@index([pairId, at])
}

model HandoffItem {
  id         String    @id @default(cuid())
  deviceId   String
  deviceName String
  kind       String    @default("link") // link | video | article
  title      String
  url        String
  position   Int       @default(0) // ثانية للتوقف في الفيديو
  status     String    @default("new") // new | opened
  openedOn   String?   // اسم الجهاز الذي فتحه
  openedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model NetProfile {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("home") // home | briefcase | coffee | laptop
  networkName String
  photoSync   Boolean  @default(true)
  notifs      Boolean  @default(true)
  clipboard   Boolean  @default(true)
  folderSync  Boolean  @default(true)
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProdState {
  id              String   @id @default("main")
  network         String   @default("منزل-5GHz")
  activeProfileId String?
  clipMode        String   @default("auto") // auto | manual
  photoSync       Boolean  @default(true)
  photoTarget     String   @default("/Pictures/FromPhone")
  photoLastAt     DateTime @default(now())
  notifsPaused    Boolean  @default(false)
  seedVer         Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model ProdBackup {
  id            String   @id @default(cuid())
  label         String
  sizeBytes     Int      @default(0)
  devicesCount  Int      @default(0)
  profilesCount Int      @default(0)
  pairsCount    Int      @default(0)
  dataJson      String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
// ============ المرحلة 10 — تقوية الأمان ============

model AuditEvent {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actor    String   // الكمبيوتر | Galaxy-S24 | جهاز غريب
  deviceId String?
  action   String   // kex | transfer | perm-denied | lock | unlock | wipe | alert | settings | trust
  detail   String
  severity String   @default("info") // info | warn | critical
  stealth  Boolean  @default(false)

  @@index([at])
}

model PermRule {
  id       String  @id @default(cuid())
  feature  String  // file_transfer | clipboard | notifications | remote_input | media | camera | microphone | system_commands | contacts | screen_mirror
  deviceId String
  enabled  Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@unique([feature, deviceId])
}

model SecState {
  id           String   @id @default("main")
  stealthMode  Boolean  @default(false)
  autoLockSec  Int      @default(60)
  blocked      String   @default("[]") // JSON: أجهزة محظورة
  rotations    Int      @default(0)
  framesSent   Int      @default(0)
  bytesOnWire  Int      @default(0)
  seedVer      Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ============ المرحلة G — صلّب الإصدار (عقد §16) ============
// إعدادات سطح المكتب المشتركة (نفس SQLite): نسخة الويب والتطبيق يقرآن
// ويكتبان الكائن نفسه عبر /api/desktop/settings — المفتاح الواحد يحمل JSON.
// المزامنة: التطبيق يسحب دوريًا خفيفًا ويدفع عند كل تغيير محلي، والويب
// يكتب مباشرة — الكائن الأخير هو الصالح (آخر كاتب يفوز كما في desktop-ui.json).
model DesktopSetting {
  key       String   @id
  value     String   // JSON: appLock | idle | updater | general
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — مركز صحة الأجهزة (عقد §26) =====
// عينات قياس زمنية لكل جهاز (بطارية/استجابة/إتاحة) + أحداث صحة (انقطاع/عودة/
// بطارية منخفضة/استجابة متدهورة/تخزين ممتلئ). العينات تُسجَّل من نبض GET
// /api/devices (خانقة 30ث لكل جهاز) ومن مسار الوكيل الحقيقي POST report.
// الاحتفاظ 24 ساعة (تنقية دورية) — تُغطي نوافذ العرض 1h/6h/24h.
model NexusHealthSample {
  id         String   @id @default(cuid())
  deviceId   String
  battery    Int
  rttMs      Int
  online     Boolean
  storagePct Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([createdAt])
}

model NexusHealthEvent {
  id         String   @id @default(cuid())
  deviceId   String
  deviceName String
  type       String   // offline | online | low-battery | rtt-degraded | storage-high
  level      String   @default("info") // info | warn
  message    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ===== NexusLink — ترسيخ قواعد الروتينات (عقد §26.ز) =====
// القاعدة الكاملة تُخزَّن JSON في payload (تسامح مستقبلي مع حقول مشغلات/أفعال
// جديدة بلا ترقية مخطط) — تُستعاد حرفيًا عند إقلاع الجسر فلا تختفي القواعد
// المنشأة عند إعادة تشغيل الخادم، وحذف قاعدة بذرية يبقى حذفًا (لا تعود).
// id = معرف القاعدة في الذاكرة نفسه (uid) — يظل مفتاح التسليح والحقب ثابتًا.
model NexusAutomationRule {
  id        String   @id
  name      String
  enabled   Boolean  @default(true)
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — ترسيخ إطلاقات الروتينات (عقد §26.ح) =====
// كل إطلاق فعلي يُرسَّخ (نجح الفعل أم فشل) — والتنبيهات غير المرئية تبقى
// بانتظار عودة الواجهة حتى لو أُطلقت بلا أي متصفح مفتوح (إكمال لـ §27.هـ:
// «نبّهني» أثناء النوم = تسمعها عند الاستيقاظ). seenAt = لحظة الرؤية (البث
// الحي لواجهة متصلة يعدّه رؤية عند التسليم). الاحتفاظ آخر 200 إطلاق —
// تنقية تلقائية بعد كل كتابة فلا ينمو الجدول بلا حد.
model NexusAutomationFire {
  id       String    @id
  ruleId   String
  ruleName String
  at       DateTime
  ok       Boolean   @default(true)
  detail   String    @default("")
  manual   Boolean   @default(false)
  seenAt   DateTime?

  @@index([at])
  @@index([ruleId, at])
}
