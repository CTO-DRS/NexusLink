// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — طبقة الاتصالات الشخصية =====

model NexusNotification {
  id         String   @id @default(cuid())
  appId      String
  appName    String
  title      String
  body       String
  deviceId   String   @default("galaxy-s24")
  actionable Boolean  @default(true)
  // new | read | replied | muted | hidden | archived
  status     String   @default("new")
  replyText  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model NexusFilter {
  id           String    @id @default("main")
  hiddenApps   String    @default("[]") // JSON: appId[]
  grouping     Boolean   @default(true)
  quietUntil   DateTime?
  soundEnabled Boolean   @default(true)
}

model NexusConversation {
  id          String         @id @default(cuid())
  address     String         @unique
  contactName String?
  unread      Int            @default(0)
  updatedAt   DateTime       @updatedAt
  messages    NexusMessage[]
}

model NexusMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  direction      String // in | out
  status         String            @default("delivered") // sending | sent | delivered | read
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model NexusContact {
  id       String  @id @default(cuid())
  name     String
  phone    String  @unique
  email    String?
  favorite Boolean @default(false)
}

model NexusCallLog {
  id          String   @id @default(cuid())
  number      String
  contactName String?
  direction   String // in | out | missed
  startedAt   DateTime
  durationSec Int      @default(0)

  @@index([startedAt])
}

model NexusPhone {
  id        String   @id @default("main")
  dnd       Boolean  @default(false)
  dndSource String? // pc | phone
  updatedAt DateTime @updatedAt
}

// ===== NexusLink — المرحلة 9: طبقة الإنتاجية =====

model ProdClip {
  id         String   @id @default(cuid())
  deviceId   String
  deviceName String
  kind       String   @default("text") // text | image | file
  content    String   @default("") // نص أو dataUrl مصغّر للصور
  fileName   String? // للملفات: الاسم الحقيقي على الجهاز المصدر
  filePath   String? // مسار افتراضي للملف على الجهاز المصدر
  size       Int      @default(0)
  mode       String   @default("manual") // auto | manual
  received   Boolean  @default(false) // استُلم فعلياً على جهاز آخر (نسخ بايتات)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SyncPair {
  id         String    @id @default(cuid())
  deviceA    String
  folderA    String
  deviceB    String
  folderB    String
  active     Boolean   @default(true)
  autoSync   Boolean   @default(true)
  lastSyncAt DateTime?
  lastCount  Int       @default(0)
  lastBytes  Int       @default(0)
  running    Boolean   @default(false)
  progress   Int       @default(0) // 0..100
  createdAt  DateTime  @default(now())

  events SyncEvent[]
}

model SyncEvent {
  id      String   @id @default(cuid())
  pairId  String
  pair    SyncPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  relPath String
  action  String // new-A2B | new-B2A | upd-A2B | upd-B2A | conflict | skip
  bytes   Int      @default(0)
  at      DateTime @default(now())

  @@index([pairId, at])
}

model HandoffItem {
  id         String    @id @default(cuid())
  deviceId   String
  deviceName String
  kind       String    @default("link") // link | video | article
  title      String
  url        String
  position   Int       @default(0) // ثانية للتوقف في الفيديو
  status     String    @default("new") // new | opened
  openedOn   String?   // اسم الجهاز الذي فتحه
  openedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model NetProfile {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("home") // home | briefcase | coffee | laptop
  networkName String
  photoSync   Boolean  @default(true)
  notifs      Boolean  @default(true)
  clipboard   Boolean  @default(true)
  folderSync  Boolean  @default(true)
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProdState {
  id              String   @id @default("main")
  network         String   @default("منزل-5GHz")
  activeProfileId String?
  clipMode        String   @default("auto") // auto | manual
  photoSync       Boolean  @default(true)
  photoTarget     String   @default("/Pictures/FromPhone")
  photoLastAt     DateTime @default(now())
  notifsPaused    Boolean  @default(false)
  seedVer         Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model ProdBackup {
  id            String   @id @default(cuid())
  label         String
  sizeBytes     Int      @default(0)
  devicesCount  Int      @default(0)
  profilesCount Int      @default(0)
  pairsCount    Int      @default(0)
  dataJson      String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}